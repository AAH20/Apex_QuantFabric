{
  "profile": "apex.quant.signal-reservation@0.1",
  "status": "synthetic-workstation-profile",
  "instruments": 8,
  "reservation_slots": 16,
  "logical_completion_queue_max": 8,
  "units_per_instrument": 16,
  "prediction_id_range": [1, 256],
  "integer_range": [0, 2147483647],
  "model": 1,
  "policy": 1,
  "config": 1,
  "threshold": 0.5,
  "numerical_absolute_tolerance": 0.000001,
  "expiry_rule": "arrival_time <= expiry",
  "watermark_rule": "exact current contiguous instrument sequence",
  "reference_model": "((integer_price % 101) - 50) / 50",
  "reset_rule": "strictly newer session, no live reservations",
  "events": ["MARKET", "PREDICTION", "DROPPED", "UNCERTAIN", "RELEASE", "RESET", "ADVANCE"],
  "wire_order": ["kind", "time", "session", "id", "instrument", "sequence", "watermark", "model", "policy", "config", "expiry", "score", "quantity", "action"],
  "trace_order": ["index", "disposition", "valid_signal", "action", "score", "session", "watermarks", "prices", "blocked_mask", "seen_bitmap", "reservations", "kernel_call_ns"],
  "decision_acceptance": "exact dispositions, valid-signal flags, actions and state; finite score differences <= absolute tolerance",
  "scope_exclusions": ["live exchange", "partial fill", "cancel/replace", "GPU execution", "NIC/DPU execution", "FPGA physical timing", "distributed ownership", "official STAC", "profitability"]
}
